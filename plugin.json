{
  "schemaVersion": 1,
  "pluginProtocol": 2,
  "id": "grok-bot",
  "displayName": "Grok Bot Background Studio",
  "exeName": "Grok Bot Background Studio.exe",
  "pipeName": "\\\\.\\pipe\\background-studio-grok-bot",
  "capabilities": {
    "commands": ["hello", "configure", "status", "apply", "pause", "restore", "shutdown"],
    "mediaKinds": ["image", "video"],
    "autoTakeover": true,
    "hotUpdate": true,
    "keepsTargetOnShutdown": true,
    "maxMediaBytes": 67108864
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fit": {"type":"string","title":"填充方式","enum":["cover","contain","fill","tile"],"enumLabels":["覆盖","适应","拉伸","平铺"],"default":"cover"},
      "positionX": {"type":"number","title":"水平位置","minimum":0,"maximum":100,"step":1,"default":50},
      "positionY": {"type":"number","title":"垂直位置","minimum":0,"maximum":100,"step":1,"default":50},
      "opacity": {"type":"number","title":"背景不透明度","minimum":0,"maximum":1,"step":0.01,"default":0.72},
      "blur": {"type":"number","title":"模糊","minimum":0,"maximum":40,"step":1,"default":0},
      "scale": {"type":"number","title":"缩放","minimum":1,"maximum":1.3,"step":0.01,"default":1},
      "overlayColor": {"type":"string","title":"遮罩颜色","format":"color","default":"#101416"},
      "overlayOpacity": {"type":"number","title":"遮罩不透明度","minimum":0,"maximum":0.9,"step":0.01,"default":0.12},
      "sidebarOpacity": {"type":"number","title":"聊天列表不透明度","minimum":0,"maximum":1,"step":0.01,"default":0.18},
      "surfaceOpacity": {"type":"number","title":"消息区不透明度","minimum":0,"maximum":1,"step":0.01,"default":0.12},
      "cardOpacity": {"type":"number","title":"卡片不透明度","minimum":0,"maximum":1,"step":0.01,"default":0.35},
      "menuOpacity": {"type":"number","title":"菜单不透明度","minimum":0,"maximum":1,"step":0.01,"default":0.9},
      "enabledOnHome": {"type":"boolean","title":"主页启用","default":true},
      "enabledOnTasks": {"type":"boolean","title":"任务页启用","default":true},
      "videoMuted": {"type":"boolean","title":"视频静音","default":true},
      "videoPlaybackRate": {"type":"number","title":"视频倍速","minimum":0.25,"maximum":2,"step":0.05,"default":1}
    }
  }
}
